# Variables d'environnement du projet NO MORE WASTE.
# Ce fichier est commité tel quel (projet scolaire, démo temporaire) : pas de vrais secrets sensibles ici.

# --- PostgreSQL ---
POSTGRES_USER=nmw_user
POSTGRES_PASSWORD=nmw_password
POSTGRES_DB=nmw
POSTGRES_PORT=5432

# --- API Go (config centralisee dans api-go/config/config.go) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=nmw_user
DB_PASSWORD=nmw_password
DB_NAME=nmw
API_PORT=8080
JWT_SECRET=nmw_dev_jwt_secret_2026

# --- SMTP (Brevo - https://app.brevo.com/settings/keys/smtp) ---
# SMTP_USER = ton adresse email Brevo, SMTP_PASSWORD = la cle SMTP generee dans Brevo (pas ton mot de passe de compte)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM="NO MORE WASTE <no-reply@nomorewaste.example.com>"

# --- Front PHP (FlightPHP) ---
# URL utilisée par le front pour appeler l'API Go (nom du service docker = "api-go")
API_BASE_URL=http://api-go:8080

# --- Nginx (port exposé sur la machine hôte) ---
NGINX_PORT=8080
