# Modele de configuration pour NO MORE WASTE.
#
# Ce fichier N'EST PAS lu par Docker : c'est install.sh qui le copie vers
# .env au premier lancement (voir install.sh.md). Une fois .env cree, c'est
# LUI la source de verite -- modifier ce modele ne change rien a une
# installation deja faite.
#
# JWT_SECRET est remplace automatiquement par un secret genere au hasard :
# ne le modifie pas a la main ici, ca ne servirait a rien.

# --- PostgreSQL ---
POSTGRES_USER=nmw_user
POSTGRES_PASSWORD=nmw_password
POSTGRES_DB=nmw
POSTGRES_PORT=5432

# --- API Go (config centralisee dans api-go/config/config.go) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=nmw_user
DB_PASSWORD=nmw_password
DB_NAME=nmw
API_PORT=8080
JWT_SECRET=change_me_a_generer

# --- SMTP (Brevo - https://app.brevo.com/settings/keys/smtp) ---
# SMTP_USER = ton adresse email Brevo, SMTP_PASSWORD = la cle SMTP generee dans Brevo (pas ton mot de passe de compte)
# Tant que ces deux valeurs restent "change_me", le site fonctionne normalement :
# seuls les emails (rappels d'adhesion, campagnes, plannings) ne partiront pas.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM="NO MORE WASTE <no-reply@nomorewaste.example.com>"

# --- Front PHP (FlightPHP) ---
# URL utilisée par le front pour appeler l'API Go (nom du service docker = "api-go")
API_BASE_URL=http://api-go:8080

# --- Nginx (port exposé sur la machine hôte) ---
NGINX_PORT=8080
